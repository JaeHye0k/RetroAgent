# 전부 필수입니다. 하나라도 비어 있으면 시작할 때 무엇이 없는지 알려주고 멈춥니다.
# 숨은 기본값은 없습니다 — 이 파일을 .env 로 복사한 뒤 값만 채우면 됩니다.

# ── 텔레그램 ────────────────────────────────────────────────
# @BotFather 에서 /newbot 으로 발급받은 토큰
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 본인 chat id. 봇에게 아무 메시지나 보낸 뒤 `npm run whoami` 로 확인.
# 이 값과 다른 chat 의 메시지는 전부 무시합니다.
TELEGRAM_CHAT_ID=123456789

# ── 노션 ────────────────────────────────────────────────────
# https://www.notion.so/my-integrations 에서 Internal Integration 생성 후 발급
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 회고 데이터베이스 id (URL 또는 하이픈 포함/미포함 모두 허용)
NOTION_DB_ID=11111111-2222-3333-4444-555555555555

# ── 동작 설정 ───────────────────────────────────────────────
# 하루치를 모아 미리보기를 보낼 시각 (HH:MM, 로컬 시간)
DIGEST_TIME=23:00
# 주기 회고(주간·월간·분기·반기·연간)를 보낼 시각.
# 일간과 같게 두면 그날 일간을 승인한 뒤 이어서 옵니다.
PERIODIC_DIGEST_TIME=23:00
# 이 시각 이전에 보낸 조각은 '전날' 회고로 귀속됩니다 (0~12)
DAY_CUTOFF_HOUR=4
TZ=Asia/Seoul

# ── claude CLI ──────────────────────────────────────────────
CLAUDE_BIN=claude
CLAUDE_MODEL=sonnet
# 정리 1회당 최대 대기 시간(ms)
COMPOSE_TIMEOUT_MS=240000

# ── 음성 인식 (Groq Whisper) ────────────────────────────────
# https://console.groq.com/keys 에서 발급
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# STT 모델 / 언어 / 인식 1회당 최대 대기 시간(ms)
GROQ_STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=ko
STT_TIMEOUT_MS=60000
